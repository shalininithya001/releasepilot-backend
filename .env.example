APP_NAME=ReleasePilot API
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
DATASET_LABEL=tyn-release-assessment-v2
JIRA_ISSUE_TYPE=Task
JIRA_LINK_TYPE=Relates
JIRA_TIMEOUT_SECONDS=30
JIRA_MAX_RETRIES=3
JIRA_RETRY_BACKOFF_SECONDS=1.0

# Provider order is tried left to right; providers without a key are skipped.
LLM_PROVIDER_ORDER=gemini,openrouter,nvidia,ollama
LLM_MIN_INTERVAL_SECONDS=6.5
LLM_TIMEOUT_SECONDS=90
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

AGENT_MAX_ITERATIONS=200
AGENT_STEPS_PER_REQUIREMENT=14
AGENT_MAX_LINK_DEPTH=4
AGENT_MAX_UNIQUE_ISSUES=150
AGENT_TOOL_TIMEOUT_SECONDS=30
